# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — real secrets are NEVER committed.
# .env.local holds your real keys and stays on your computer only.
.env*
# ...but the blank template IS committed, so the project documents what keys it needs.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.env*

# Obsidian vault — personal notes, not part of the website project.
/Nicks Site/

# Old "shared with you" email notifications — no actual content (just Google
# Docs share links, not attachments), not part of the website project.
/Albums/
