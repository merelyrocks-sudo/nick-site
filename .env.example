# =============================================================================
# TEMPLATE FILE — safe to commit. Contains NO real secrets.
#
# Do not edit this file with real keys. Instead put real keys in .env.local,
# which is gitignored and never leaves your computer.
# =============================================================================

# --- Stripe (TEST MODE) -----------------------------------------------------
# Both of these come from the Stripe Dashboard in TEST mode.
# Test keys are safe: they cannot move real money.

# Starts with: pk_test_
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Starts with: sk_test_   <-- SECRET. Never paste this into a chat or commit it.
STRIPE_SECRET_KEY=

# --- Site --------------------------------------------------------------------
# The address the site runs at. Used to send buyers back after checkout.
# Local development: http://localhost:3000
# Vercel/production: https://yourdomain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
